# Backend Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to source control.

# ── Supabase ──────────────────────────────────────────────────────────────────
# Your Supabase project URL (found in Supabase dashboard → Project Settings → API)
SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase service role key — SERVER-SIDE ONLY. NEVER expose to the frontend.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ── Gemini ────────────────────────────────────────────────────────────────────
# Google Gemini API key (https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your-gemini-api-key

# ── CORS ──────────────────────────────────────────────────────────────────────
# Frontend origin(s) — comma-separated if multiple.
# Local:      http://localhost:3000
# Production: https://your-app.vercel.app,http://localhost:3000
FRONTEND_URL=http://localhost:3000

# ── App ───────────────────────────────────────────────────────────────────────
# Environment: development | production
APP_ENV=development

# Maximum upload file size in bytes (default: 50 MB)
MAX_UPLOAD_SIZE_BYTES=52428800
